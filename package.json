{
  "name": "itshagennothagen",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "dev:api": "npm run db:local && npm run build && npx wrangler pages dev dist --port 8788",
    "db:local": "npx wrangler d1 execute weed-whacker-leaderboard --local --file=functions/schema.sql",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm test --workspaces --if-present && vitest run --config functions/vitest.config.ts functions",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p functions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:prose": "vale src/content"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "atxactly": "file:packages/atxactly",
    "remark-github-blockquote-alert": "^2.1.0",
    "tailwindcss": "^4.3.3",
    "tile-map": "file:packages/tile-map",
    "weed-whacker": "file:packages/weed-whacker"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.5.1",
    "@vvago/vale": "^3.21.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.2"
  },
  "overrides": {
    "vite": "^8.0.13"
  }
}
