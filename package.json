{
  "name": "itshagennothagen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "dev:api": "npm run db:local && npm run build && npx wrangler pages dev dist --port 8788",
    "db:local": "npx wrangler d1 execute weed-whacker-leaderboard --local --file=functions/schema.sql",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm test --workspaces --if-present && vitest run --config functions/vitest.config.ts functions",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p functions",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.4.8",
    "remark-github-blockquote-alert": "^2.1.0",
    "tailwindcss": "^4.3.1",
    "weed-whacker": "file:packages/weed-whacker"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^24.12.3",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.107.0"
  },
  "overrides": {
    "vite": "^7.3.2"
  }
}
