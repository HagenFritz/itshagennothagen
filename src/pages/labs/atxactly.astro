  }
  .mt-toast.show {
    transform: translate(-50%, 0);
    opacity: 1;
  }
  .mt-toast b {
    display: block;
    font-size: 28px;
    line-height: 1.1;
  }
  .mt-toast > span#mt-toast-p {
