---
import Base from '../../layouts/Base.astro'
import locationData from '../../data/atxactly-locations.json'

type Loc = {
  id: string
  name: string
  lat: number
  lon: number
  category: string
  tier: string
  difficulty: number | null
  story: string | null
  extra: string | null
  storyUrl: string | null
  status: string
  shape?: number[][][]
  photo?: { url: string; attribution: string } | null
}

const eligible = (locationData as Loc[]).filter((l) => l.status === 'eligible')

// CARTO serves label-free tiles, which is what keeps the map unreadable during
// play. Keyless requests are watermarked, so the key is required for a clean
// board; without it the game falls back to Esri, which labels parks and streets
// at high zoom.
const cartoKey = import.meta.env.PUBLIC_CARTO_API_KEY ?? ''
---

<Base title="ATXactly · Hagen Fritz">
  <div
    id="mt"
    data-locations={JSON.stringify(eligible)}
    data-carto-key={cartoKey}
  >
    <header class="mt-head">
      <div class="mt-score"><span>SCORE</span><b id="mt-total">0</b></div>
      <div class="mt-mid">
        <div class="mt-band">
          <span id="mt-band-txt">Round 1 of 5 · Easy</span>
          <span id="mt-mult" class="mt-mult m1">1x</span>
        </div>
        <div class="mt-nameline">
          <span id="mt-cat" class="mt-cat"></span>
          <span id="mt-name" class="mt-name">Loading…</span>
        </div>
        <div id="mt-sub" class="mt-sub">Tap as close as you can</div>
      </div>
      <button id="mt-help" class="mt-help" aria-label="How to play">?</button>
      <button id="mt-again" class="mt-btn" hidden>Play again</button>
      <button id="mt-share" class="mt-btn" hidden>Copy score</button>
    </header>

    <div class="mt-stage">
      <canvas id="mt-tiles" aria-hidden="true"></canvas>
      <canvas
        id="mt-over"
        role="application"
        aria-label="Map of Austin. Tap where you think the place is; zoom with the buttons or arrow keys."
      ></canvas>
      <div id="mt-credit" class="mt-credit map-credit"></div>
      <div id="mt-toast" class="mt-toast">
        <b id="mt-toast-d"></b>
        <span id="mt-toast-p"></span>
        <span id="mt-toast-break" class="mt-break" hidden>
          <span id="mt-break-base"></span>
          <span id="mt-break-mult" class="mt-break-chip"></span>
        </span>
      </div>
      <div class="mt-zoom">
        <button
          id="mt-zoom-in"
          class="mt-zoom-btn"
          aria-label="Zoom in"
          data-tip="Zoom in (↑ or +)">+</button
        >
        <button
          id="mt-zoom-out"
          class="mt-zoom-btn"
          aria-label="Zoom out"
          data-tip="Zoom out (↓ or −)">&minus;</button
        >
      </div>
      <div id="mt-hint" class="mt-hint" hidden>Tap a pin to read its story</div>
      <div id="mt-confirm" class="mt-confirm" hidden>
        <span>Drop your guess here? <kbd class="mt-kbd">Enter</kbd></span>
        <button id="mt-confirm-yes" class="mt-btn">Confirm</button>
        <button id="mt-confirm-no" class="mt-ghost">Cancel</button>
      </div>
    </div>

    <div id="mt-guide" class="mt-guide" hidden>
      <svg id="mt-guide-mask" class="mt-guide-mask" aria-hidden="true"></svg>
      <div id="mt-guide-notes"></div>
      <button id="mt-guide-close" class="mt-btn mt-guide-close">Got it</button>
    </div>

    <dialog id="mt-dialog" class="mt-dialog">
      <button id="mt-close" class="mt-close" aria-label="Close">×</button>
      <div class="mt-dialog-meta" id="mt-d-meta"></div>
      <h2 id="mt-d-name"></h2>
      <figure id="mt-d-photo" class="mt-dialog-photo" hidden>
        <img id="mt-d-img" alt="" loading="lazy" />
        <figcaption id="mt-d-credit"></figcaption>
      </figure>
      <p id="mt-d-story"></p>
      <p id="mt-d-extra"></p>
      <a id="mt-d-link" target="_blank" rel="noopener" hidden>Wikipedia</a>
    </dialog>
  </div>
</Base>

<style is:global>
  #mt {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: #0b0f1a;
    z-index: 50;
    color: #e6e8ee;
  }
  .mt-head {
    display: flex;
    align-items: stretch;
    gap: 14px;
    padding: 10px 14px;
    background: #0e1424;
    border-bottom: 1px solid #1e2740;
    flex: 0 0 auto;
  }
  .mt-score {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 2px solid #c2410c;
    border-radius: 8px;
    padding: 4px 16px;
    min-width: 104px;
  }
  .mt-score span {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: #c2410c;
  }
  .mt-score b {
    font-size: 40px;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    transition: transform 0.15s;
  }
  .mt-score b.bump {
    transform: scale(1.18);
    color: #f59e5b;
  }
  .mt-mid {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
  }
  .mt-band {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8b93a7;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .mt-mult {
    font-weight: 700;
    padding: 1px 7px;
    border-radius: 999px;
    border: 1px solid currentColor;
    transition:
      color 0.3s,
      transform 0.3s;
  }
  .mt-mult.m1 {
    color: #8b93a7;
  }
  .mt-mult.m2 {
    color: #38bdf8;
  }
  .mt-mult.m3 {
    color: #f59e5b;
  }
  .mt-mult.pulse {
    transform: scale(1.25);
  }
  .pts-m1 {
    color: #8b93a7;
  }
  .pts-m2 {
    color: #38bdf8;
  }
  .pts-m3 {
    color: #f59e5b;
  }
  .mt-nameline {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
  }
  .mt-cat {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: ui-monospace, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 3px 9px 3px 7px;
    border-radius: 999px;
    border: 1px solid currentColor;
    white-space: nowrap;
  }
  .mt-cat .ico {
    font-size: 13px;
    line-height: 1;
  }
  .mt-cat.c-neighborhood {
    color: #5ea9e8;
  }
  .mt-cat.c-park {
    color: #6bbf59;
  }
  .mt-cat.c-landmark {
    color: #f59e5b;
  }
  .mt-cat.c-civic {
    color: #c084fc;
  }
  .mt-cat.c-venue {
    color: #e8546b;
  }
  .mt-cat.c-town {
    color: #e8b04b;
  }
  .mt-cat.c-food {
    color: #f2778a;
  }
  .mt-cat.c-water {
    color: #4cc3d9;
  }
  .mt-name {
    font-size: 22px;
    font-weight: 650;
    line-height: 1.15;
    animation: mt-slide 0.35s ease-out;
  }
  .mt-sub {
    font-size: 13px;
    color: #8b93a7;
  }
  @keyframes mt-slide {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .mt-btn {
    background: #c2410c;
    color: #fff;
    border: 0;
    border-radius: 8px;
    padding: 10px 16px;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    align-self: center;
  }
  .mt-stage {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
  }
  #mt-tiles,
  #mt-over {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  #mt-tiles {
    /* CARTO's dark_nolabels averages about 15/255 luminance, so it needs a
       hard lift to read at all. The Esri fallback is mid-grey and would be
       blown out by this, but the fallback only applies without a key. */
    filter: brightness(2.6) contrast(1.45) saturate(0.7);
  }
  /* dark_all is as dark as dark_nolabels, so the results map needs nearly the
     same lift. The old 1.35 was tuned for the bright OSM fallback and left
     streets and labels almost invisible once the CARTO key was in place. */
  #mt-tiles.labelled {
    filter: brightness(2.8) contrast(1.45) saturate(0.9);
  }
  #mt-over {
    touch-action: none;
    cursor: crosshair;
  }
  #mt-over.pins {
    cursor: pointer;
  }
  .mt-credit {
    position: absolute;
    left: 0.375rem;
    bottom: 0.25rem;
    z-index: 2;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    background: rgb(11 15 26 / 0.75);
    color: var(--muted-foreground);
    font-size: 10px;
  }
  .mt-toast {
    position: absolute;
    left: 50%;
    bottom: 36px;
    transform: translate(-50%, 30px);
    opacity: 0;
    background: #0e1424f0;
    border: 1px solid #2a3556;
    border-radius: 14px;
    padding: 14px 26px;
    text-align: center;
    pointer-events: none;
    transition:
      transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.2),
      opacity 0.25s;
