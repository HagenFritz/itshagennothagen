---
import { getCollection, type CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '../../layouts/Base.astro'

export async function getStaticPaths() {
  const trips = await getCollection('roadtrips')
  return trips.map((trip) => ({
    params: { slug: trip.id },
    props: { trip },
  }))
}

interface Props {
  trip: CollectionEntry<'roadtrips'>
}

const { trip } = Astro.props
const { title, tagline, intro, miles, route, stops } = trip.data

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  })

const dates = stops.map((s) => s.date.valueOf())
const first = fmt(new Date(Math.min(...dates)))
const last = fmt(new Date(Math.max(...dates)))
const dateRange = first === last ? first : `${first} to ${last}`
const summary = [`${stops.length} stops`, miles && `${miles} mi`, dateRange]
  .filter(Boolean)
  .join(' · ')

// Keyless CARTO returns a watermarked tile with HTTP 200, so the package falls
// back to Esri when the key is empty rather than rendering the watermark.
const cartoKey = import.meta.env.PUBLIC_CARTO_API_KEY ?? ''

const mapData = {
  route,
  stops: stops.map((s) => ({ lat: s.lat, lon: s.lon })),
}
---

<Base title={`${title} · Hagen Fritz`} description={tagline}>
  <a
    href="/roadtrips"
    class="text-sm text-muted-foreground transition-colors hover:text-foreground"
  >
    ← Road trips
  </a>

  <h1 class="mt-4 text-3xl font-semibold tracking-tight">{title}</h1>
  <p class="mt-1 text-muted-foreground">{tagline}</p>

  <div
    class="relative mt-5 h-[calc(100dvh-20rem)] min-h-[420px] overflow-hidden rounded-lg border border-border bg-card"
  >
    <div
      id="map"
      tabindex="-1"
      role="application"
      aria-label={`Map of the ${title} route. Use the stop list below the map to open a stop.`}
      data-carto-key={cartoKey}
      class="absolute inset-0"
    >
    </div>

    <div class="absolute right-2 top-2 flex flex-col gap-1">
      <button
        id="zoom-in"
        aria-label="Zoom in"
        class="flex h-8 w-8 items-center justify-center rounded border border-border bg-background/85 text-lg leading-none text-foreground transition-colors hover:border-primary hover:text-primary"
        >+</button
      >
      <button
        id="zoom-out"
        aria-label="Zoom out"
        class="flex h-8 w-8 items-center justify-center rounded border border-border bg-background/85 text-lg leading-none text-foreground transition-colors hover:border-primary hover:text-primary"
        >&minus;</button
      >
    </div>

    <div
      class="map-credit absolute bottom-1 right-1.5 z-[2] rounded bg-background/75 px-1.5 py-0.5 text-[10px] text-muted-foreground max-sm:bottom-auto max-sm:left-1.5 max-sm:right-auto max-sm:top-1"
    >
      <span id="attribution"></span> · Routing by <a
        href="https://project-osrm.org/">OSRM</a
      >
    </div>

    {
      stops.map((stop, i) => (
        <article
          id={`stop-${i + 1}`}
          class:list={['trip-card', i === 0 && 'is-collapsed']}
          data-stop={i + 1}
          tabindex="-1"
          hidden
        >
          <button
            type="button"
            class="trip-card-close"
            aria-label="Close"
            data-close
          >
            &times;
          </button>
          {i === 0 && (
            <div class="p-4 pr-10">
              <h2 class="font-medium">{title}</h2>
              <p class="mt-0.5 text-sm text-muted-foreground">{tagline}</p>
              <p class="trip-card-summary mt-2 text-xs text-muted-foreground">
                {summary}
              </p>
            </div>
          )}
          <div class="trip-card-body">
            {i === 0 && (
              <div class="space-y-3 px-4 pb-4 text-sm text-foreground">
                {intro.map((paragraph) => (
                  <p set:html={paragraph} />
                ))}
              </div>
            )}
            {stop.images.length > 0 && (
              <div class="relative" data-carousel>
                <div
                  class:list={[
                    'flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden',
                    stop.images.length > 1 && 'cursor-pointer',
                  ]}
                  data-track
                >
                  {stop.images.map((img) => (
                    <figure class="trip-card-slide">
                      <Image
                        src={img.src}
                        alt={img.alt}
                        widths={[320, 640]}
                        sizes="320px"
                        loading="eager"
                        class="trip-card-photo"
                      />
                      {stop.images.some((other) => other.caption) && (
                        <figcaption class="trip-card-caption">
                          {img.caption}
                        </figcaption>
                      )}
                    </figure>
                  ))}
                </div>
                {stop.images.length > 1 && (
                  <div class="pointer-events-none absolute inset-x-0 top-[10.5rem] flex justify-center gap-1.5">
                    {stop.images.map((_, d) => (
                      <span
                        class="size-1.5 rounded-full bg-white/40 transition-colors aria-[current=true]:bg-white"
                        aria-current={d === 0 ? 'true' : 'false'}
                        data-dot
                      />
                    ))}
                  </div>
                )}
              </div>
            )}
            <div class="p-4 pr-10">
              <h2 class="font-medium">
                {i + 1}. {stop.title}
              </h2>
              <time
                datetime={stop.date.toISOString().slice(0, 10)}
                class="mt-0.5 block text-xs italic text-muted-foreground"
              >
                {fmt(stop.date)}
              </time>
              <p class="mt-2 text-sm text-muted-foreground">{stop.blurb}</p>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <p class="mt-3 text-sm text-muted-foreground">
    {miles && <span>{miles} miles</span>}
    {miles && ' · '}Tap a pin or a stop below · drag to pan · scroll to zoom
  </p>

  <ol id="stop-list" class="mt-6 space-y-1.5">
    {
      stops.map((stop, i) => (
        <li>
          <button
            type="button"
            class="flex w-full items-baseline gap-3 rounded border border-border bg-card px-3 py-2 text-left transition-colors hover:border-primary"
            data-stop={i + 1}
            aria-expanded="false"
            aria-controls={`stop-${i + 1}`}
          >
            <span class="w-5 shrink-0 font-mono text-xs text-muted-foreground tabular-nums">
              {i + 1}
            </span>
            <span class="flex-1 text-sm">{stop.title}</span>
            <span class="shrink-0 text-xs text-muted-foreground">
              {fmt(stop.date)}
            </span>
          </button>
        </li>
      ))
    }
  </ol>

  <script
    is:inline
    type="application/json"
    id="map-data"
    set:html={JSON.stringify(mapData)}
  />
</Base>

<script>
  import {
    boundsOf,
    cartoDark,
    createTileMap,
    nearest,
    toLatLon,
    OVERLAY_CLASS,
    type LatLon,
    type MapView,
    type RouteCoord,
  } from 'tile-map'

  type MapData = { route: RouteCoord[]; stops: LatLon[] }

  const container = document.getElementById('map') as HTMLElement
  const { route, stops } = JSON.parse(
    document.getElementById('map-data')!.textContent!,
  ) as MapData
  const routePoints = route.map(toLatLon)

  const cards = new Map<string, HTMLElement>()
  for (const card of document.querySelectorAll<HTMLElement>('.trip-card')) {
    cards.set(card.dataset.stop!, card)
  }
  const listButtons = [
    ...document.querySelectorAll<HTMLButtonElement>('#stop-list button'),
  ]

  // The first stop's card carries the trip intro and is the one open on load.
  const START = '1'

  const docked = window.matchMedia('(max-width: 639px)')
  const canHover = window.matchMedia('(hover: hover)')
  const coarse = window.matchMedia('(pointer: coarse)')

  let selected: string | null = null
  let hovered: number | null = null
  let restoreFocus: HTMLElement | null = null
  // The package hands a view to every callback but exposes no getter, so the
  // callbacks stash the latest one for the code paths that run outside them.
  let latestView: MapView | null = null
  const mapView = () => latestView!

  const CARD_GAP = 14
  const EDGE = 8
  // The attribution strip is a license obligation and sits above the card, so
  // an anchored card stops short of it rather than being covered by it.
  const CREDIT_HEIGHT = 20

  const anchorOf = (key: string) => stops[Number(key) - 1]!

  const bounds = boundsOf([...routePoints, ...stops])

  function dockHeight() {
    if (!docked.matches) return 32
    const card = cards.get(START)!
    const wasHidden = card.hidden
    card.hidden = false
    const h = card.getBoundingClientRect().height
    card.hidden = wasHidden
    return Math.round(h) + EDGE
  }

  // Mutated in place rather than replaced: the camera holds this same object,
  // so a breakpoint change reaches the next fitBounds() without remounting.
  const padding = { top: 32, right: 32, bottom: 32, left: 32 }

  function applyPadding() {
    padding.bottom = docked.matches ? dockHeight() : 32
  }

  applyPadding()

  const map = createTileMap(container, {
    source: cartoDark(container.dataset.cartoKey ?? ''),
    bounds,
    zoom: { min: 4, max: 17 },
    padding,
    onDraw: (ctx, view) => {
      latestView = view
      draw(ctx, view)
    },
    onChange: (view) => {
      latestView = view
      position()
    },
    onTap: (px, py, view) => {
      const hit = nearest(stops, px, py, view.project, coarse.matches ? 22 : 14)
      if (!hit) {
        select(null)
        return
      }
      restoreFocus = container
      select(String(stops.indexOf(hit) + 1))
    },
    onHover: (px, py, view) => {
      if (!canHover.matches) return
      const hit = nearest(stops, px, py, view.project, 14)
      map.setCursor(hit ? 'pointer' : 'grab')
      const next = hit ? stops.indexOf(hit) : null
      if (next === hovered) return
      hovered = next
      map.redraw()
    },
  })

  function draw(ctx: CanvasRenderingContext2D, view: MapView) {
    ctx.beginPath()
    for (const [i, p] of routePoints.entries()) {
      const s = view.project(p)
      if (i === 0) ctx.moveTo(s.x, s.y)
      else ctx.lineTo(s.x, s.y)
    }
    ctx.strokeStyle = 'rgba(194,65,12,0.9)'
    ctx.lineWidth = 4
    ctx.lineCap = 'round'
    ctx.lineJoin = 'round'
    ctx.stroke()

    const selectedIndex = selected ? Number(selected) - 1 : null

    for (const [i, s] of stops.entries()) {
      const p = view.project(s)
      const isSelected = i === selectedIndex
      if (isSelected || (canHover.matches && i === hovered)) {
        ctx.beginPath()
        ctx.arc(p.x, p.y, isSelected ? 12 : 10, 0, Math.PI * 2)
        ctx.strokeStyle = 'rgba(238,242,251,0.5)'
        ctx.lineWidth = 1.5
        ctx.stroke()
      }
      ctx.beginPath()
      ctx.arc(p.x, p.y, isSelected ? 7.5 : 5.5, 0, Math.PI * 2)
      ctx.fillStyle = '#c2410c'
      ctx.fill()
      ctx.strokeStyle = '#0b0f1a'
      ctx.lineWidth = 2
      ctx.stroke()
    }
  }

  function position() {
    if (!selected) return
    const card = cards.get(selected)!
    if (docked.matches) {
      card.style.left = ''
      card.style.top = ''
      return
    }
    const rect = container.getBoundingClientRect()
    const p = mapView().project(anchorOf(selected))
    const w = card.offsetWidth
    const h = card.offsetHeight
    let left = p.x + CARD_GAP
    if (left + w > rect.width - EDGE) left = p.x - CARD_GAP - w
    left = Math.max(EDGE, Math.min(rect.width - w - EDGE, left))
    const top = Math.max(
      EDGE,
      Math.min(rect.height - h - EDGE - CREDIT_HEIGHT, p.y - h / 2),
    )
    card.style.left = `${left}px`
    card.style.top = `${top}px`
  }

  function select(
    key: string | null,
    options: { pan?: boolean; focus?: boolean } = {},
  ) {
    if (key === selected) {
      if (key && options.focus !== false) focusCard(key)
      return
    }
    if (selected) cards.get(selected)!.hidden = true
    selected = key
    for (const b of listButtons) {
      b.setAttribute('aria-expanded', String(b.dataset.stop === key))
    }
    writeHash()
    if (!key) {
      map.redraw()
      const back = restoreFocus
      restoreFocus = null
      back?.focus()
      return
    }
    const card = cards.get(key)!
    card.hidden = false
    card.classList.toggle('is-collapsed', key === START)
    if (options.pan !== false) panIntoView(key)
    position()
    map.redraw()
    if (options.focus !== false) focusCard(key)
  }

  function focusCard(key: string) {
    cards.get(key)!.focus({ preventScroll: true })
  }

  // Pan only, and only as far as it takes for the pin and its card to clear the
  // container. Zooming would throw away the fitted view of the whole route. The
  // card is clamped vertically either way, so only its width is reserved.
  function panIntoView(key: string) {
    const view = mapView()
    const p = view.project(anchorOf(key))
    const card = cards.get(key)!
    const w = docked.matches ? EDGE : card.offsetWidth + CARD_GAP + EDGE
    const bottom = docked.matches ? padding.bottom : EDGE
    let dx = 0
    let dy = 0
    if (p.x < EDGE) dx = p.x - EDGE
    else if (p.x + w > view.width && p.x - w < 0) dx = p.x + w - view.width
    if (p.y < EDGE) dy = p.y - EDGE
    else if (p.y > view.height - bottom) dy = p.y - (view.height - bottom)
    if (!dx && !dy) return
    map.panTo(view.unproject(view.width / 2 + dx, view.height / 2 + dy))
  }

  // replaceState never fires hashchange, so the listener below cannot loop back
  // into select(); the guard is only for a hash the user edits by hand.
  function writeHash() {
    const hash = selected && selected !== START ? `#stop-${selected}` : ''
    const url = location.pathname + location.search + hash
    if (url !== location.pathname + location.search + location.hash) {
      history.replaceState(null, '', url)
    }
  }

  // On load the first stop opens over the fitted route with no pan; a
  // deep-linked stop pans its pin and card into view.
  function readHash(options: { focus?: boolean } = {}) {
    const match = /^#stop-(\d+)$/.exec(location.hash)
    const index = match ? Number(match[1]) : null
    if (index && index >= 1 && index <= stops.length) {
      select(String(index), options)
    } else {
      select(START, { ...options, pan: false })
    }
  }

  document.getElementById('attribution')!.innerHTML = map.attribution()
  map.setCursor('grab')

  container
    .querySelector('.' + OVERLAY_CLASS)!
    .addEventListener('pointerleave', () => {
      if (hovered === null) return
      hovered = null
      map.redraw()
    })

  for (const card of cards.values()) {
    card.addEventListener('wheel', (e) => e.stopPropagation())
    card.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        const carousel = card.querySelector<HTMLElement>('[data-carousel]')
        const step = carousel && carousels.get(carousel)
        if (!step) return
        e.preventDefault()
        step(e.key === 'ArrowRight' ? 1 : -1)
        return
      }
      if (e.key !== 'Escape') return
      e.stopPropagation()
      restoreFocus = restoreFocus ?? container
      select(null)
    })
    card.querySelector('[data-close]')!.addEventListener('click', (e) => {
      e.stopPropagation()
      select(null)
    })
  }

  // The collapsed dock is a tap target in its own right: tapping anywhere on it
  // that is not the close button expands it.
  cards.get(START)!.addEventListener('click', (e) => {
    const card = cards.get(START)!
    if (!card.classList.contains('is-collapsed')) return
    if ((e.target as HTMLElement).closest('[data-close]')) return
    card.classList.remove('is-collapsed')
  })

  for (const button of listButtons) {
    button.addEventListener('click', () => {
      restoreFocus = button
      select(button.dataset.stop!)
      container.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
    })
  }

  document
    .getElementById('zoom-in')!
    .addEventListener('click', () => map.zoomBy(1))
  document
    .getElementById('zoom-out')!
    .addEventListener('click', () => map.zoomBy(-1))

  docked.addEventListener('change', () => {
    applyPadding()
    if (selected) {
      cards
        .get(selected)!
        .classList.toggle('is-collapsed', selected === START && docked.matches)
    }
    map.fitBounds()
    position()
  })

  window.addEventListener('hashchange', () => readHash())

  const carousels = new Map<HTMLElement, (delta: number) => void>()
  for (const carousel of document.querySelectorAll<HTMLElement>(
    '[data-carousel]',
  )) {
    const track = carousel.querySelector<HTMLElement>('[data-track]')
    if (!track) continue
    const slides = [...track.children] as HTMLElement[]
    if (slides.length < 2) continue
    const dots = [...carousel.querySelectorAll<HTMLElement>('[data-dot]')]

    let index = 0
    const observer = new IntersectionObserver(
      (observed) => {
        for (const o of observed) {
          if (!o.isIntersecting) continue
          index = slides.indexOf(o.target as HTMLElement)
          dots.forEach((dot, i) =>
            dot.setAttribute('aria-current', String(i === index)),
          )
        }
      },
      { root: track, threshold: 0.6 },
    )
    for (const slide of slides) observer.observe(slide)

    const step = (delta: number) => {
      const next = (index + delta + slides.length) % slides.length
      track.scrollTo({ left: slides[next]!.offsetLeft, behavior: 'smooth' })
    }
    carousels.set(carousel, step)
    track.addEventListener('click', () => step(1))
  }

  map.fitBounds()
  readHash({ focus: false })
</script>
