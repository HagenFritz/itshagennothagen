---
import Base from '../layouts/Base.astro'
---

<Base title="Weed Whacker · Hagen Fritz">
  <h1 class="text-3xl font-semibold tracking-tight">Weed Whacker</h1>

  <p class="mt-4 max-w-[70ch] text-muted-foreground">
    Clear weeds off your plot, earn a little cash, and buy more land to grow on.
    You have three minutes. Whack as many weeds as you can. Move with WASD or
    the arrow keys, chop with space, and buy the tile you are facing with B.
  </p>

  <div
    id="mobile-note"
    class="mt-8 hidden rounded-lg border border-border bg-card p-5"
  >
    <p class="text-muted-foreground">
      This one wants a keyboard. Come back on a laptop or desktop to play.
    </p>
  </div>

  <div id="game-wrap" class="mt-8">
    <div
      class="relative mx-auto aspect-square w-full max-w-[672px] overflow-hidden rounded-lg border border-border bg-black"
    >
      <canvas
        id="game"
        class="block h-full w-full rounded-lg [image-rendering:pixelated]"
      ></canvas>

      <div
        id="start-screen"
        class="absolute inset-0 flex flex-col items-center justify-center gap-4 bg-black/70 text-center"
      >
        <p class="text-lg font-semibold text-foreground">Ready?</p>
        <button
          id="start-btn"
          disabled
          class="rounded-md bg-primary px-4 py-2 font-medium text-white transition-opacity hover:opacity-90 disabled:opacity-50"
          >Loading...</button
        >
      </div>

      <div
        id="end-screen"
        class="absolute inset-0 hidden flex-col items-center justify-center gap-3 bg-black/80 text-center"
      >
        <p class="text-sm uppercase tracking-wide text-muted-foreground">
          Time
        </p>
        <p class="text-3xl font-semibold text-foreground">
          <span id="final-score">0</span> weeds
        </p>

        <form id="submit-form" class="hidden flex-col items-center gap-2">
          <div class="flex items-center gap-2">
            <input
              id="name-input"
              type="text"
              maxlength="20"
              placeholder="Your name"
              autocomplete="off"
              class="w-40 rounded-md border border-border bg-card px-3 py-1.5 text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
            />
            <button
              id="submit-btn"
              type="submit"
              class="rounded-md bg-primary px-3 py-1.5 font-medium text-white transition-opacity hover:opacity-90 disabled:opacity-50"
              >Submit</button
            >
          </div>
          <p id="submit-msg" class="min-h-5 text-sm text-muted-foreground"></p>
        </form>
        <p id="lb-note" class="hidden text-sm text-muted-foreground">
          Leaderboard unavailable right now. Your run still counts in spirit.
        </p>

        <button
          id="again-btn"
          class="mt-2 rounded-md bg-primary px-4 py-2 font-medium text-white transition-opacity hover:opacity-90"
          >Play again</button
        >
      </div>
    </div>

    <div class="mx-auto mt-3 flex max-w-[672px] items-center gap-6 text-base">
      <span class="flex items-center gap-2 text-muted-foreground">
        <img
          src="/games/weed-whacker/hud_weed.png"
          alt="weeds whacked"
          width="32"
          height="32"
          class="h-8 w-8 [image-rendering:pixelated]"
        />
        <span id="hud-score" class="font-semibold text-foreground">0</span>
      </span>

      <span class="flex items-center gap-2 text-muted-foreground">
        <img
          src="/games/weed-whacker/coin.png"
          alt="money"
          width="32"
          height="32"
          class="h-8 w-8 [image-rendering:pixelated]"
        />
        <span id="hud-money" class="font-semibold text-foreground">0</span>
      </span>

      <span
        class="flex items-center gap-2 text-muted-foreground"
        title="Chop cooldown"
      >
        <img
          src="/games/weed-whacker/hoe.png"
          alt="chop cooldown"
          width="28"
          height="28"
          class="h-7 w-7 [image-rendering:pixelated]"
        />
        <span
          class="relative block h-3 w-24 overflow-hidden rounded-full bg-muted"
        >
          <span
            id="hud-cooldown"
            class="absolute inset-y-0 left-0 rounded-full bg-primary"
            style="width: 100%"></span>
        </span>
      </span>

      <span
        id="hud-time"
        class="ml-auto font-semibold tabular-nums text-foreground">3:00</span
      >
      <button
        id="mute-btn"
        class="rounded-md border border-border px-2 py-1 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >Sound: on</button
      >
    </div>
  </div>

  <div class="mx-auto mt-12 max-w-[672px]">
    <h2 class="text-xl font-semibold tracking-tight">Top 10</h2>
    <ol id="lb-list" class="mt-4 hidden space-y-1"></ol>
    <p id="lb-status" class="mt-4 text-muted-foreground">Loading scores...</p>
  </div>
</Base>

<script>
  import {
    CHOP_COOLDOWN_MS,
    createGameAudio,
    mount,
    RUN_DURATION_MS,
    type GameHandle,
    type GameState,
  } from 'weed-whacker'

  const lbList = document.getElementById('lb-list')!
  const lbStatus = document.getElementById('lb-status')!

  async function loadBoard(fresh = false) {
    try {
      const res = await fetch('/api/scores', {
        cache: fresh ? 'no-store' : 'default',
      })
      if (!res.ok) throw new Error(String(res.status))
      const { scores } = (await res.json()) as {
        scores: { name: string; score: number }[]
      }
      lbList.textContent = ''
      if (scores.length === 0) {
        lbStatus.textContent = 'No scores yet. Be the first.'
        lbStatus.classList.remove('hidden')
        lbList.classList.add('hidden')
        return
      }
      scores.forEach((entry, i) => {
        const li = document.createElement('li')
        li.className =
          'flex items-baseline gap-3 rounded-md border border-border bg-card px-3 py-1.5'
        const rank = document.createElement('span')
        rank.className = 'w-6 shrink-0 text-sm text-muted-foreground'
        rank.textContent = `${i + 1}.`
        const name = document.createElement('span')
        name.className =
          'min-w-0 overflow-hidden text-ellipsis whitespace-nowrap'
        name.textContent = entry.name
        const score = document.createElement('span')
        score.className = 'ml-auto font-semibold tabular-nums text-foreground'
        score.textContent = String(entry.score)
        li.append(rank, name, score)
        lbList.appendChild(li)
      })
      lbList.classList.remove('hidden')
      lbStatus.classList.add('hidden')
    } catch {
      lbStatus.textContent = 'Leaderboard unavailable right now.'
      lbStatus.classList.remove('hidden')
      lbList.classList.add('hidden')
    }
  }

  void loadBoard()

  const isTouch = window.matchMedia(
    '(hover: none) and (pointer: coarse)',
  ).matches

  if (isTouch) {
    document.getElementById('mobile-note')!.classList.remove('hidden')
    document.getElementById('game-wrap')!.classList.add('hidden')
  } else {
    void setup()
  }

  async function setup() {
    const canvas = document.getElementById('game') as HTMLCanvasElement
    const startScreen = document.getElementById('start-screen')!
    const endScreen = document.getElementById('end-screen')!
    const startBtn = document.getElementById('start-btn') as HTMLButtonElement
    const againBtn = document.getElementById('again-btn')!
    const muteBtn = document.getElementById('mute-btn')!
    const hudScore = document.getElementById('hud-score')!
    const hudMoney = document.getElementById('hud-money')!
    const hudTime = document.getElementById('hud-time')!
    const hudCooldown = document.getElementById('hud-cooldown')!
    const finalScore = document.getElementById('final-score')!
    const submitForm = document.getElementById('submit-form') as HTMLFormElement
    const nameInput = document.getElementById('name-input') as HTMLInputElement
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement
    const submitMsg = document.getElementById('submit-msg')!
    const lbNote = document.getElementById('lb-note')!

    let runToken: string | null = null
    let lastScore = 0

    const fetchToken = async () => {
      runToken = null
      try {
        const res = await fetch('/api/runs', { method: 'POST' })
        if (res.ok) {
          const data = (await res.json()) as { token?: string }
          runToken = data.token ?? null
        }
      } catch {
        // Leaderboard is optional; the run plays either way.
      }
    }

    const audio = createGameAudio('/games/weed-whacker/')
    muteBtn.textContent = audio.isMuted() ? 'Sound: off' : 'Sound: on'

    const formatTime = (remainingMs: number) => {
      const total = Math.max(0, Math.ceil(remainingMs / 1000))
      const m = Math.floor(total / 60)
      const s = total % 60
      return `${m}:${s.toString().padStart(2, '0')}`
    }

    const paintHud = (state: GameState) => {
      hudScore.textContent = String(state.whacked)
      hudMoney.textContent = String(Math.floor(state.money))
      hudTime.textContent = formatTime(RUN_DURATION_MS - state.elapsedMs)
      // Bar is full when the hoe is ready and empties as the cooldown runs.
      const ready = 1 - state.player.chopCooldownMs / CHOP_COOLDOWN_MS
      hudCooldown.style.width = `${Math.round(ready * 100)}%`
    }

    let handle: GameHandle
    try {
      handle = await mount(canvas, {
        assetBaseUrl: '/games/weed-whacker/',
        onEvent: (event) => {
          audio.playEvent(event)
          if (event.type === 'runEnded') {
            lastScore = event.whacked
            finalScore.textContent = String(event.whacked)
            if (runToken) {
              submitForm.classList.remove('hidden')
              submitForm.classList.add('flex')
              lbNote.classList.add('hidden')
            } else {
              submitForm.classList.add('hidden')
              submitForm.classList.remove('flex')
              lbNote.classList.remove('hidden')
            }
            endScreen.classList.remove('hidden')
            endScreen.classList.add('flex')
          }
        },
        onStateChange: paintHud,
      })
    } catch (err) {
      console.error(err)
      startScreen.innerHTML =
        '<p class="text-muted-foreground">The game could not load. Try refreshing.</p>'
      return
    }

    startBtn.textContent = 'Start (3:00)'
    startBtn.disabled = false

    const begin = () => {
      audio.unlock()
      void fetchToken()
      startScreen.classList.add('hidden')
      endScreen.classList.add('hidden')
      endScreen.classList.remove('flex')
      submitBtn.disabled = false
      submitMsg.textContent = ''
      hudScore.textContent = '0'
      hudMoney.textContent = '0'
      hudTime.textContent = formatTime(RUN_DURATION_MS)
      handle.start()
    }

    submitForm.addEventListener('submit', (e) => {
      e.preventDefault()
      void submitScore()
    })

    const submitScore = async () => {
      const name = nameInput.value.trim()
      if (!name) {
        submitMsg.textContent = 'Enter a name first.'
        return
      }
      submitBtn.disabled = true
      submitMsg.textContent = 'Submitting...'
      try {
        const res = await fetch('/api/scores', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: runToken, name, score: lastScore }),
        })
        if (res.ok) {
          const { placement } = (await res.json()) as { placement: number }
          submitMsg.textContent = `You placed #${placement}.`
          void loadBoard(true)
        } else if (res.status === 429) {
          submitMsg.textContent =
            'Too many submissions from your network. Try again later.'
          submitBtn.disabled = false
        } else if (res.status === 401) {
          submitMsg.textContent =
            'This run could not be verified, so the score was not saved.'
        } else {
          submitMsg.textContent = 'That name did not pass. Try another.'
          submitBtn.disabled = false
        }
      } catch {
        submitMsg.textContent = 'Network hiccup. Try again.'
        submitBtn.disabled = false
      }
    }

    startBtn.addEventListener('click', begin)
    againBtn.addEventListener('click', begin)
    muteBtn.addEventListener('click', () => {
      audio.setMuted(!audio.isMuted())
      muteBtn.textContent = audio.isMuted() ? 'Sound: off' : 'Sound: on'
      handle.focus()
    })
  }
</script>
