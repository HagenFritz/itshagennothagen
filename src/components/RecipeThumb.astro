---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  image: CollectionEntry<'recipes'>['data']['image']
}

const { image } = Astro.props
---

{image ? (
  <Image
    src={image.src}
    alt={image.alt}
    width={160}
    class="size-20 shrink-0 rounded-md object-cover"
  />
) : (
  <svg
    viewBox="0 0 24 24"
    width="80"
    height="80"
    aria-hidden="true"
    class="size-20 shrink-0 rounded-md border border-white/20 p-5 text-primary"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M3 11h18a9 9 0 0 1-18 0Z" />
    <path d="M8 20h8" />
    <path d="M9 7c0-1.5 1-2 1-3.5M13 7c0-1.5 1-2 1-3.5" />
  </svg>
)}
